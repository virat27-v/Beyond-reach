# ----------------------------------------------------------------------------
# Beyond Reach — Firebase Authentication (frontend-only)
#
# Values come from your Firebase project:
#   Firebase Console → Project settings (gear) → General → Your apps → SDK
#   configuration and API keys. Replace the placeholders with your own
#   values — do not commit real values here.
#
# Set these same six variables in Vercel (Project → Settings →
# Environment Variables, for ALL environments), then redeploy.
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
